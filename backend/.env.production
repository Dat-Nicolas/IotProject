NODE_ENV=production
PORT=3000
HOST=0.0.0.0
API_PREFIX=api

# Neon PostgreSQL Connection (Required)
# Get this from https://console.neon.tech/
# Format: postgresql://username:password@host.neon.tech/dbname?schema=public&sslmode=require
DATABASE_URL="postgresql://username:password@host.neon.tech/smart_ac?schema=public&sslmode=require"

# Security (Generate new values)
JWT_SECRET="your-super-secure-random-string-min-32-chars"
JWT_EXPIRES_IN=86400

# Device Authentication
SENSOR_DEVICE_KEY="your-esp32-device-key"
